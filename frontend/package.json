{
  "name": "frontend",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "dev": "concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && npm run electron:compile && cross-env ELECTRON_START_URL=http://localhost:4200 electron .\"",
    "build": "ng build",
    "build:web": "ng build",
    "build:app": "ng build && npm run electron:compile && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "vitest run --config vitest.electron.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "build": {
    "appId": "com.naturaceites.sms20",
    "productName": "SMS 2.0",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ng-zorro-antd": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
